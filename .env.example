# Cloudflare Pages / Wrangler Environment Variables
# For local development with wrangler, copy these to `.dev.vars`

# Google Gemini API Key for the Oracle
GEMINI_API_KEY=

# GitHub Personal Access Token (Classic or Fine-Grained)
# Scope: public_repo (read-only)
# Needed to increase API rate limit (60 -> 5000 req/hr)
GITHUB_TOKEN=
